# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyo

# Python build/package artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# Type checking / linting caches
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------

.venv/
venv/
env/
ENV/
.env/
.python-version

# ------------------------------------------------------------
